
#include <iostream>
using namespace std;

template <class T>
class Larger
{
    T a, b;

public:
    // Parameterized constructor
    Larger(T x, T y)
    {
        a = x;
        b = y;
        cout << "Constructor called." << endl;
    }

    void display()
    {
        if (a > b)
            cout << "Larger value = " << a << endl;
        else if (b > a)
            cout << "Larger value = " << b << endl;
        else
            cout << "Both values are equal." << endl;
    }

    // Destructor
    ~Larger()
    {
        cout << "Destructor called." << endl;
    }
};

int main()
{
    Larger<int> obj(10, 20);
    obj.display();

    return 0;
}
